@page "/shows/{id}"
@using Microsoft.AspNetCore.Components
@using MauiBlazorWeb.Shared.Models.DTOs
@using MauiBlazorWeb.Shared.Services
@inject IShowService ShowService

<PageTitle>Show Details</PageTitle>

<div class="container py-3">
    @if (isLoading)
    {
        <div class="text-muted">Loading...</div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger">@error</div>
    }
    else if (show is null)
    {
        <div class="text-muted">Show not found.</div>
    }
    else
    {
        <h2>@show.Name</h2>
        <p class="text-muted">@show.Description</p>
        <div class="mb-3">
            <strong>Date:</strong> @show.ShowDate.ToShortDateString() @(show.EndDate.HasValue ? $" - {show.EndDate.Value.ToShortDateString()}" : "")
            <br />
            <strong>Status:</strong> @show.Status @(show.IsPrivate ? " • Private" : "")
        </div>

        @if (show.Divisions?.Any() == true)
        {
            <h4>Divisions</h4>
            <div class="accordion" id="divisions">
                @foreach (var d in show.Divisions.OrderBy(x => x.SortOrder).ThenBy(x => x.Name))
                {
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="heading_@d.Id">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@d.Id">
                                @d.Name (@d.DivisionType)
                            </button>
                        </h2>
                        <div id="collapse_@d.Id" class="accordion-collapse collapse" data-bs-parent="#divisions">
                            <div class="accordion-body">
                                @if (d.ShowClasses?.Any() == true)
                                {
                                    <table class="table table-sm table-striped">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>Name</th>
                                                <th>Max Entries</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var c in d.ShowClasses.OrderBy(x => x.SortOrder).ThenBy(x => x.ClassNumber))
                                            {
                                                <tr>
                                                    <td>@c.ClassNumber</td>
                                                    <td>@c.Name</td>
                                                    <td>@c.MaxEntries</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <div class="text-muted">No classes defined.</div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public string id { get; set; } = string.Empty;
    private ShowDto? show;
    private bool isLoading = true;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            isLoading = true;
            error = null;
            show = await ShowService.GetShowByIdAsync(id);
            if (show is null || show.IsPrivate)
            {
                show = null;
                return;
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
